<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient"
    android:paddingTop="@dimen/index_paddingTop"
    android:paddingEnd="80dp"
    android:paddingStart="80dp"
    android:paddingBottom="@dimen/index_paddingBottom"
    tools:context=".MainActivity">

    <com.twd.gamesetting.FocusScrollView
        android:id="@+id/sv_settings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:descendantFocusability="afterDescendants"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout
                android:id="@+id/ll_language"
                android:layout_width="match_parent"
                android:layout_height="@dimen/item_height"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="@dimen/index_ll_marginTop"
                android:background="@drawable/bg_option_selector"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:gravity="center_vertical"
                android:paddingStart="36dp"
                android:paddingEnd="36dp"
                android:orientation="horizontal">

                <TextView
                    android:duplicateParentState="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/index_language"
                    android:textColor="@drawable/text_color_selector"
                    android:textSize="26sp"/>

                <TextView
                    android:duplicateParentState="true"
                    android:id="@+id/tv_cur_lang"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textColor="@drawable/text_color_selector"
                    android:layoutDirection="ltr"
                    android:textDirection="ltr"
                    android:textSize="26sp"
                    android:text="简体中文"/>

                <ImageView
                    android:duplicateParentState="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:src="@drawable/arrow_selector"/>
            </LinearLayout>

            <!-- 声音 -->
            <LinearLayout
                android:id="@+id/ll_sound"
                android:layout_width="match_parent"
                android:layout_height="@dimen/item_height"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="@dimen/index_ll_marginTop"
                android:background="@drawable/bg_option_selector"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:gravity="center_vertical"
                android:paddingStart="36dp"
                android:paddingEnd="36dp"
                android:orientation="horizontal">

                <TextView
                    android:duplicateParentState="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/index_sound"
                    android:textColor="@drawable/text_color_selector"
                    android:textSize="26sp"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>

                <TextView
                    android:duplicateParentState="true"
                    android:id="@+id/tv_sound_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="26sp"
                    android:textColor="@drawable/text_color_selector"
                    android:text="开启"/>
            </LinearLayout>

            <!-- 亮度 -->
            <LinearLayout
                android:id="@+id/ll_bright"
                android:layout_width="match_parent"
                android:layout_height="@dimen/item_height"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="@dimen/index_ll_marginTop"
                android:background="@drawable/bg_option_selector"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:gravity="center_vertical"
                android:paddingStart="36dp"
                android:paddingEnd="36dp"
                android:orientation="horizontal">

                <TextView
                    android:duplicateParentState="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/index_bright"
                    android:textColor="@drawable/text_color_selector"
                    android:textSize="26sp"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="2"/>

                <ImageView
                    android:duplicateParentState="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/arrow_left_selector"/>

                <TextView
                    android:duplicateParentState="true"
                    android:id="@+id/tv_cur_bright"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="@drawable/text_color_selector"
                    android:textSize="26sp"
                    android:text="100%"/>

                <ImageView
                    android:duplicateParentState="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/arrow_selector"/>
            </LinearLayout>

            <!-- WIFI -->
            <TextView
                android:id="@+id/tv_wifi"
                android:layout_width="match_parent"
                android:layout_height="@dimen/item_height"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="@dimen/index_ll_marginTop"
                android:background="@drawable/bg_option_selector"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:gravity="center_vertical"
                android:paddingStart="36dp"
                android:text="@string/index_Wifi"
                android:textColor="@drawable/text_color_selector"
                android:textSize="26sp"
                android:drawableEnd="@drawable/arrow_selector"
                android:drawablePadding="12dp"
                android:paddingEnd="36dp"/>

            <!-- 蓝牙 -->
            <TextView
                android:id="@+id/tv_bluetooth"
                android:layout_width="match_parent"
                android:layout_height="@dimen/item_height"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="@dimen/index_ll_marginTop"
                android:background="@drawable/bg_option_selector"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:gravity="center_vertical"
                android:paddingStart="36dp"
                android:text="@string/index_Bluetooth"
                android:textColor="@drawable/text_color_selector"
                android:textSize="26sp"
                android:drawableEnd="@drawable/arrow_selector"
                android:drawablePadding="12dp"
                android:paddingEnd="36dp"/>

            <!-- 关于本机 -->
            <LinearLayout
                android:id="@+id/ll_about"
                android:layout_width="match_parent"
                android:layout_height="@dimen/item_height"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="@dimen/index_ll_marginTop"
                android:background="@drawable/bg_option_selector"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:gravity="center_vertical"
                android:paddingStart="36dp"
                android:paddingEnd="36dp"
                android:orientation="horizontal">

                <TextView
                    android:duplicateParentState="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/index_About"
                    android:textColor="@drawable/text_color_selector"
                    android:textSize="26sp"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"/>

                <ImageView
                    android:duplicateParentState="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:src="@drawable/arrow_selector"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_rgb"
                android:layout_width="match_parent"
                android:layout_height="@dimen/item_height"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="@dimen/index_ll_marginTop"
                android:background="@drawable/bg_option_selector"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:gravity="center_vertical"
                android:paddingStart="36dp"
                android:paddingEnd="36dp"
                android:orientation="horizontal">

                <TextView
                    android:duplicateParentState="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RGB灯效"
                    android:textColor="@drawable/text_color_selector"
                    android:textSize="26sp"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"/>

                <ImageView
                    android:duplicateParentState="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:src="@drawable/arrow_selector"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_time"
                android:layout_width="match_parent"
                android:layout_height="@dimen/item_height"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="@dimen/index_ll_marginTop"
                android:background="@drawable/bg_option_selector"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:gravity="center_vertical"
                android:paddingStart="36dp"
                android:paddingEnd="36dp"
                android:orientation="horizontal">

                <TextView
                    android:duplicateParentState="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/time_setting"
                    android:textColor="@drawable/text_color_selector"
                    android:textSize="26sp"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"/>

                <ImageView
                    android:duplicateParentState="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:src="@drawable/arrow_selector"/>
            </LinearLayout>

        </LinearLayout>
    </com.twd.gamesetting.FocusScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>